# Keep the Docker build context lean: this context serves both
# backend/Dockerfile (backend/ + protocol/) and runner/Dockerfile
# (runner/ + protocol/). Adjust if a frontend Dockerfile is added later.

.git
.claude

# Frontend (not part of the backend image)
node_modules
build
coverage
public
src
package.json
package-lock.json
tailwind.config.js
postcss.config.js
tsconfig.json

# Rust build output (never ship host artifacts into the context)
backend/target
protocol/target
runner/target

# Secrets — never allow env files or keys into an image layer
**/.env
**/.env.*
!**/.env.example
*.pem
*.key

# Docs & local tooling
docs
docker-compose.yml
README.md
