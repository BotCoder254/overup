# Overup runner configuration.
# Copy to runner/.env for local runs (dotenvy loads it), or use it as the
# --env-file for Docker / the Environment tab in Dokploy.
# Full deployment guide: docs/deploy-runner.md

# --- Control plane connection -------------------------------------------------

# Origin of the Overup backend. http:// becomes ws://, https:// becomes wss://.
# Production example: https://api.example.com
OVERUP_URL=http://localhost:8080

# Registration token — shown ONCE when the runner is created via
# POST /api/workspaces/{id}/runners (only its SHA-256 hash is stored
# server-side). A revoked token cannot be reused; create a new runner.
RUNNER_TOKEN=

# OPTIONAL shared HMAC key that verifies signed job payloads. Leave unset
# and the runner uses the key the control plane delivers automatically over
# the authenticated connection (held in memory only, refreshed on every
# connect). Set it only to pin the key locally — then it MUST be
# byte-for-byte identical to the backend's RUNNER_JOB_SIGNING_KEY
# (>= 32 bytes; generate with: openssl rand -hex 32) and it takes
# precedence over the delivered key.
#RUNNER_JOB_SIGNING_KEY=

# Display name sent in the hello message.
RUNNER_NAME=overup-runner

# Comma-separated labels. A job is only dispatched here when its runs-on
# values are a SUBSET of these labels — cover everything your workflows
# declare (e.g. ubuntu-latest) or pipelines stay Queued.
RUNNER_LABELS=self-hosted,linux,x64,ubuntu-latest

# --- Per-job container hardening (defaults are least-privilege) ----------------

# Drop ALL Linux capabilities in job containers (no-new-privileges is always
# set regardless). Set false only for workloads that genuinely need caps.
RUNNER_CAP_DROP=true

# Per-job memory limit in bytes (default 2 GiB; 0 = unlimited).
RUNNER_JOB_MEMORY_BYTES=2147483648

# Per-job CPU limit in nano-CPUs (default 2 CPUs; 0 = unlimited).
RUNNER_JOB_NANO_CPUS=2000000000

# Per-job process cap (0 = unlimited).
RUNNER_JOB_PIDS_LIMIT=512

# Job container network: bridge | none | isolated
# (isolated = throwaway per-job bridge network, removed after the job).
RUNNER_JOB_NETWORK=bridge

# Run job containers as this user instead of the image default,
# e.g. 1000:1000. Empty = image user.
RUNNER_JOB_USER=

# Read-only root filesystem for job containers (+ tmpfs /tmp).
# /workspace stays writable via the bind mount.
RUNNER_JOB_READONLY_ROOTFS=false

# --- Docker daemon connection ---------------------------------------------------

# Unset = local socket / named pipe (or whatever is mounted at
# /var/run/docker.sock inside a containerized runner).
# For a remote TLS-secured daemon (never expose an unauthenticated :2375):
#DOCKER_HOST=tcp://docker-host.example.com:2376
#DOCKER_TLS_VERIFY=1
#DOCKER_CERT_PATH=/certs   # directory containing ca.pem, cert.pem, key.pem

# --- Logging ---------------------------------------------------------------------

RUST_LOG=info
