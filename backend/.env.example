# PostgreSQL connection string — paste your own database URL here.
# Hosted providers (Neon, Supabase, Railway, RDS, ...) work as-is;
# TLS is supported via rustls, e.g. append ?sslmode=require.
# (docker-compose.yml at the repo root is an optional local alternative:
#  postgres://overup:overup@localhost:5432/overup)
DATABASE_URL=

# GitHub OAuth App credentials.
# Register at: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Exact redirect URL registered with the GitHub OAuth App (allow-list of one).
OAUTH_REDIRECT_URL=http://localhost:8080/auth/github/callback

# GitHub App (repository + workflow management).
# Register at: GitHub -> Settings -> Developer settings -> GitHub Apps -> New GitHub App
#   Setup URL:   http://localhost:8080/auth/github/app/setup  (redirect on install)
#   Webhook URL: https://<your-tunnel>/webhooks/github  (smee.io/cloudflared for local dev)
#   Permissions: Repository metadata (read), Contents (read)
#   Events:      push, repository, installation, installation repositories, pull request
GITHUB_APP_CLIENT_ID=
# Path to the downloaded private key PEM (or set GITHUB_APP_PRIVATE_KEY_B64
# with the base64-encoded PEM instead).
GITHUB_APP_PRIVATE_KEY_PATH=
# Webhook secret configured on the GitHub App (HMAC-SHA256 verification).
GITHUB_WEBHOOK_SECRET=
# Public slug of the app (from its URL: github.com/apps/<slug>).
GITHUB_APP_SLUG=

# Where the React app is served; used for CORS and post-login redirects.
FRONTEND_URL=http://localhost:3000

# Address the API server binds to.
BIND_ADDR=0.0.0.0:8080

# Set to true in production (requires HTTPS). Keep false for local dev over http.
COOKIE_SECURE=false

# Session lifetime in hours (168 = 7 days).
SESSION_TTL_HOURS=168

# --- Pipeline execution -----------------------------------------------------

# Shared key (>= 32 random bytes) that signs job payloads sent to runners
# (HMAC-SHA256). Every runner must be started with the same value.
# Generate with: openssl rand -hex 32
RUNNER_JOB_SIGNING_KEY=

# Container image for jobs that declare no container and no known runs-on
# label.
DEFAULT_JOB_IMAGE=ubuntu:24.04

# Execution budgets (seconds) and size caps (bytes).
JOB_TIMEOUT_SECONDS=3600
PIPELINE_TIMEOUT_SECONDS=7200
MAX_LOG_BYTES_PER_JOB=10485760
MAX_ARTIFACT_BYTES=104857600
MAX_ARTIFACTS_PER_JOB=10

# Cloudflare R2 storage (S3-compatible API) for artifacts AND gzip'd log
# archives. All four together or none: without R2, pipelines run fine but
# artifact uploads are denied and logs simply stay in Postgres.
# Create an API token at Cloudflare -> R2 -> Manage R2 API Tokens.
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=

# Storage retention (janitor runs hourly).
# Days an uploaded artifact stays downloadable before it expires and its R2
# object is deleted.
ARTIFACT_RETENTION_DAYS=30
# Hours a never-confirmed (pending) artifact row may linger before cleanup.
ARTIFACT_PENDING_TTL_HOURS=24
# Days a finished job's log chunks stay hot in Postgres after archival to
# R2 (only pruned when R2 is configured).
LOG_HOT_RETENTION_DAYS=7

# Structured logging filter.
RUST_LOG=info,backend=debug,tower_http=info
