# PostgreSQL connection string — paste your own database URL here.
# Hosted providers (Neon, Supabase, Railway, RDS, ...) work as-is;
# TLS is supported via rustls, e.g. append ?sslmode=require.
# (docker-compose.yml at the repo root is an optional local alternative:
#  postgres://overup:overup@localhost:5432/overup)
DATABASE_URL=

# GitHub OAuth App credentials.
# Register at: GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Exact redirect URL registered with the GitHub OAuth App (allow-list of one).
OAUTH_REDIRECT_URL=http://localhost:8080/auth/github/callback

# GitHub App (repository + workflow management).
# Register at: GitHub -> Settings -> Developer settings -> GitHub Apps -> New GitHub App
#   Setup URL:   http://localhost:8080/auth/github/app/setup
#                (check "Redirect on update"; in production use the API origin,
#                 e.g. https://api.example.com/auth/github/app/setup)
#   IMPORTANT:   leave "Request user authorization (OAuth) during installation"
#                UNCHECKED — enabling it makes GitHub redirect installs to the
#                OAuth callback without a state parameter and the install fails.
#   Webhook URL: https://<your-tunnel>/webhooks/github  (smee.io/cloudflared for local dev)
#   Permissions: Repository metadata (read), Contents (read),
#                Checks (read & write — for reporting pipeline status back to
#                commits/PRs via the Checks API; existing installations must
#                approve the permission update before reporting works)
#   Events:      push, repository, installation, installation repositories, pull request
GITHUB_APP_CLIENT_ID=
# Path to the downloaded private key PEM (or set GITHUB_APP_PRIVATE_KEY_B64
# with the base64-encoded PEM instead).
GITHUB_APP_PRIVATE_KEY_PATH=
# Webhook secret configured on the GitHub App (HMAC-SHA256 verification).
GITHUB_WEBHOOK_SECRET=
# Public slug of the app (from its URL: github.com/apps/<slug>).
GITHUB_APP_SLUG=

# Report pipeline status back to GitHub as check runs (queued → in_progress
# → completed with a details link to the pipeline page) for push/PR/tag
# pipelines. Needs the App's Checks (Read & write) permission — without it
# the backend logs one warning per installation and keeps running normally.
# Manual dispatches never report.
GITHUB_CHECKS_ENABLED=true

# Where the React app is served; used for CORS and post-login redirects.
FRONTEND_URL=http://localhost:3000

# Address the API server binds to.
BIND_ADDR=0.0.0.0:8080

# Set to true in production (requires HTTPS). Keep false for local dev over http.
COOKIE_SECURE=false

# Session lifetime in hours (168 = 7 days).
SESSION_TTL_HOURS=168

# Set to true when the backend sits behind a trusted reverse proxy
# (Traefik/Dokploy/nginx): the active-sessions list then records the real
# client IP from the proxy-appended X-Forwarded-For hop instead of the
# proxy's address. Display-only; rate limiting always uses the socket peer.
TRUST_PROXY=false

# --- Pipeline execution -----------------------------------------------------

# Shared key (>= 32 random bytes) that signs job payloads sent to runners
# (HMAC-SHA256). Every runner must be started with the same value.
# Generate with: openssl rand -hex 32
RUNNER_JOB_SIGNING_KEY=

# Container image for jobs that declare no container and no known runs-on
# label. The catthehacker/ubuntu:act-* family (what nektos/act and Gitea
# Actions default to) is the MEDIUM GitHub-runner-compatible image with
# Node/npm/yarn, Python, git, build-essential etc. preinstalled
# (~500 MB compressed). It does NOT ship every toolchain — notably no Rust
# (`cargo: not found`) or Go — so a job needing one pins its own image in
# workflow YAML with the GitHub `container:` key, e.g. `container: rust:1`,
# `container: node:22`, `container: golang:1.23`. (`uses: actions/setup-*`
# steps are not executed; overup emits a plan notice pointing at the
# equivalent `container:` pin. `uses: actions/checkout` is a no-op — the
# runner checks the repository out into /workspace automatically.)
DEFAULT_JOB_IMAGE=catthehacker/ubuntu:act-latest

# --- Secrets Management (optional but recommended) ---------------------------
# Master key for envelope-encrypting workspace/repository secrets (exactly
# 32 bytes, hex- or base64-encoded). Generate with: openssl rand -hex 32
# Without it the Secrets API denies creation cleanly, and pipelines for
# repositories that already have stored secrets fail closed
# (secrets_unavailable) rather than run without their credentials.
# LOSING THIS KEY MAKES EXISTING SECRET VALUES PERMANENTLY UNDECRYPTABLE —
# there is no plaintext escrow by design; re-enter values to recover.
#SECRETS_MASTER_KEY=

# --- Hosted runners (optional) ----------------------------------------------
# Let the control plane provision runner containers itself ("create and
# wait" in the UI — no manual install). Requires Docker access on this host.
# The provisioner probes, in order: RUNNER_PROVISIONER_DOCKER_SOCKET, then
# DOCKER_HOST (+ DOCKER_TLS_VERIFY / DOCKER_CERT_PATH), then the well-known
# local sockets (/var/run/docker.sock, /run/docker.sock, and rootless
# Docker's $XDG_RUNTIME_DIR/docker.sock / /run/user/<uid>/docker.sock).
# Docker being unreachable no longer disables the feature: the backend
# retries every 30s and hosted runners come back the moment the daemon does.
# If you see "docker unreachable" on Ubuntu: add the backend user to the
# `docker` group (usermod -aG docker <user>), or mount /var/run/docker.sock
# into the backend container, or point the socket var below at the rootless
# socket.
#RUNNER_PROVISIONER=docker
# Explicit Docker endpoint for the PROVISIONER'S OWN connection: a unix
# socket path (unix:// prefix optional), e.g. rootless Docker's
# $XDG_RUNTIME_DIR/docker.sock. Remote TCP daemons go through DOCKER_HOST
# instead so TLS is handled on the standard path. Usually unset.
#RUNNER_PROVISIONER_DOCKER_SOCKET=
# URL runner containers use to reach this control plane. It must be
# reachable FROM INSIDE a container — never localhost/127.0.0.1 (inside a
# container that is the container itself). On a single host with Docker's
# default bridge, http://172.17.0.1:8080 usually works; with a public API
# origin use that instead.
#RUNNER_PROVISIONER_OVERUP_URL=
# Runner image to run.
#RUNNER_IMAGE=ghcr.io/botcoder254/overup-runner:latest
# Job images pre-pulled into the Docker daemon after every successful
# provisioner (re)connect — i.e. on every backend deploy/restart — so the
# runner's pulling_image stage finds them locally. Comma-separated; default
# is DEFAULT_JOB_IMAGE. The runner image itself is always warmed too. Pull
# failures are warn-only and never affect hosted-runner availability.
# NOTE: this is the way to "bake" job images into a deployment — the backend
# Dockerfile cannot do it (images live in the host daemon's store, not
# inside the backend image).
#RUNNER_PREPULL_IMAGES=catthehacker/ubuntu:act-latest
# DOCKER_HOST passed through to runner containers so they can execute jobs.
# SECURITY: leave unset to mount /var/run/docker.sock into runner containers
# instead — that mount is root-equivalent on the host, so prefer a
# TLS-secured tcp://…:2376 daemon here when isolation matters. Never expose
# an unauthenticated tcp://2375 daemon.
#RUNNER_PROVISIONER_DOCKER_HOST=
# Dedicated Docker bridge network runner containers join (created at startup
# if missing). Containers on it must still reach RUNNER_PROVISIONER_OVERUP_URL.
# Set to "bridge" to opt out of the dedicated network.
#RUNNER_PROVISIONER_NETWORK=overup-runners
# Resource profile applied when a create request doesn't pick one (also used
# by workspace auto-provisioning): small (1 CPU/1 GiB), standard (2/2 GiB),
# or large (4/4 GiB). Limits bound the runner container AND are forwarded to
# its job containers via RUNNER_JOB_* env.
#RUNNER_PROVISIONER_DEFAULT_PROFILE=standard
# Auto-create one hosted runner ("hosted-1", labels
# self-hosted,linux,x64,ubuntu-latest) whenever a workspace is created.
# Default true when the provisioner is enabled; failures never block
# workspace creation.
#RUNNER_AUTO_PROVISION=true
# Hosted-runner quotas (managed, non-revoked runners). Both must be >= 1 —
# disable hosted runners with RUNNER_PROVISIONER=off, not a zero quota.
#HOSTED_RUNNERS_PER_WORKSPACE=3
#HOSTED_RUNNERS_GLOBAL=20

# Execution budgets (seconds) and size caps (bytes).
JOB_TIMEOUT_SECONDS=3600
PIPELINE_TIMEOUT_SECONDS=7200
MAX_LOG_BYTES_PER_JOB=10485760
MAX_ARTIFACT_BYTES=104857600
MAX_ARTIFACTS_PER_JOB=10

# Object storage for artifacts AND gzip'd log archives (and workspace
# logos). Two S3-compatible backends are supported; configure either, both,
# or neither:
#   - MinIO (below) is the DEFAULT / primary store whenever it is configured.
#   - Cloudflare R2 (further below) is the fallback when MinIO is also
#     configured, and the primary when it is the only one.
# With both set, server-side writes fall back to R2 automatically when the
# MinIO write fails, and every object remembers which store holds it. With
# neither, pipelines run fine but artifact uploads are denied and logs
# simply stay in Postgres.

# MinIO (or any S3-compatible endpoint). All four together or none. The
# bucket is created at startup when missing. The local docker-compose MinIO
# uses: endpoint http://localhost:9000, credentials overup / overup-minio.
# Plain http is fine on localhost; a non-loopback http endpoint draws a
# startup warning (credentials would cross the network in cleartext).
#MINIO_ENDPOINT=http://localhost:9000
#MINIO_ACCESS_KEY_ID=
#MINIO_SECRET_ACCESS_KEY=
#MINIO_BUCKET=overup
# Optional: region (default us-east-1) and path-style addressing (default
# true — the standard MinIO deployment shape).
#MINIO_REGION=us-east-1
#MINIO_FORCE_PATH_STYLE=true

# Cloudflare R2. All four together or none: acts as the fallback store when
# MinIO is configured, or the primary when it is the only backend.
# Create an API token at Cloudflare -> R2 -> Manage R2 API Tokens.
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=

# Storage retention (janitor runs hourly).
# Days an uploaded artifact stays downloadable before it expires and its R2
# object is deleted. This is the global fallback — per-kind retention
# policies (1–400 days) are configurable per workspace in the Artifacts UI
# and take precedence at upload time.
ARTIFACT_RETENTION_DAYS=30
# Hours a never-confirmed (pending) artifact row may linger before cleanup.
ARTIFACT_PENDING_TTL_HOURS=24
# Days a finished job's log chunks stay hot in Postgres after archival to
# object storage (only pruned when MinIO or R2 is configured).
LOG_HOT_RETENTION_DAYS=7

# Session hardening. Sessions expire after SESSION_TTL_HOURS absolutely, and
# ALSO after this many hours of inactivity (0 disables the idle timeout).
SESSION_IDLE_TIMEOUT_HOURS=72

# Notification Center retention (independent from audit retention — the
# audit ledger is permanent; notifications are operational awareness).
# Days an ARCHIVED notification is kept before hard deletion.
NOTIFICATION_RETENTION_DAYS=90
# Days after a notification is read before it auto-archives.
NOTIFICATION_AUTO_ARCHIVE_DAYS=14

# Structured logging filter.
RUST_LOG=info,backend=debug,tower_http=info
